rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidReservation(data, userId) {
      return data.userId == userId &&
             data.reservationCode is string && data.reservationCode.size() > 0 && data.reservationCode.size() <= 50 &&
             data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 100 &&
             data.date is string && data.date.size() > 0 &&
             data.timeSlot is string && data.timeSlot.size() > 0 &&
             data.guestCount is number && data.guestCount > 0 && data.guestCount <= 50 &&
             data.status in ['CONFIRMED', 'SEATED', 'CANCELLED'] &&
             (!('tableNumber' in data) || data.tableNumber is number) &&
             (!('zone' in data) || (data.zone is string && data.zone.size() <= 100)) &&
             (!('specialRequests' in data) || (data.specialRequests is string && data.specialRequests.size() <= 500)) &&
             (!('occasion' in data) || (data.occasion is string && data.occasion.size() <= 100)) &&
             (!('guestPhone' in data) || (data.guestPhone is string && data.guestPhone.size() <= 50)) &&
             (!('guestEmail' in data) || (data.guestEmail is string && data.guestEmail.size() <= 150)) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    function isValidOrder(data, userId) {
      return data.userId == userId &&
             data.orderCode is string && data.orderCode.size() > 0 && data.orderCode.size() <= 50 &&
             data.grandTotal is number && data.grandTotal >= 0 &&
             data.orderStatus is string && data.orderStatus.size() > 0 &&
             data.paymentStatus is string && data.paymentStatus.size() > 0 &&
             (!('guestName' in data) || (data.guestName is string && data.guestName.size() <= 100)) &&
             (!('orderType' in data) || (data.orderType is string && data.orderType.size() <= 50)) &&
             (!('destination' in data) || (data.destination is string && data.destination.size() <= 100)) &&
             (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0)) &&
             (!('taxAmount' in data) || (data.taxAmount is number && data.taxAmount >= 0)) &&
             (!('tipAmount' in data) || (data.tipAmount is number && data.tipAmount >= 0)) &&
             (!('paymentType' in data) || (data.paymentType is string && data.paymentType.size() <= 50)) &&
             (!('transactionRef' in data) || (data.transactionRef is string && data.transactionRef.size() <= 100)) &&
             (!('itemsSummary' in data) || (data.itemsSummary is string && data.itemsSummary.size() <= 2000)) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);

      match /reservations/{reservationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidReservation(request.resource.data, userId);
      }

      match /orders/{orderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidOrder(request.resource.data, userId);
      }
    }
  }
}
